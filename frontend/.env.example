# Frontend configuration. Copy to .env.local for local development.
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time, so set them
# before `npm run build` (or pass them as Docker build args).

# Public URL of the backend API + WebSocket server (no trailing slash).
# Required for production builds; defaults to http://localhost:3001 in `npm run dev`.
NEXT_PUBLIC_API_URL=http://localhost:3001
