# Backend configuration. Copy to .env for local development, or set these as
# environment variables / secrets on your hosting platform. NEVER commit real values.
# Variables marked [prod-required] make the server refuse to start when
# NODE_ENV=production and they are missing or invalid (see src/config/env.validation.ts).

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=3001
# [prod-required] Random, >= 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=
# [prod-required] Public URL of the frontend (Stripe redirects, email links).
APP_URL=http://localhost:3000
# [prod-required] Comma-separated exact origins allowed to call the API/WebSocket.
CORS_ORIGINS=http://localhost:3000
# Number of reverse-proxy hops in front of the app (for real client IPs), or "false".
TRUST_PROXY=1

# --- Database: PostgreSQL 13–18 (any managed provider) -------------------------
# [prod-required] EITHER a connection URL (most PaaS: Render, Railway, Heroku, Fly,
# Supabase, Neon, DigitalOcean)...
DATABASE_URL=
# ...OR separate settings (common on AWS RDS / Azure / Google Cloud SQL / Kubernetes).
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Apply pending migrations automatically at boot (default true).
DB_MIGRATIONS_RUN=true
# TLS. Most managed Postgres needs DB_SSL=true. A URL "?sslmode=require" also works
# (disable | require | verify-full | no-verify); DB_SSL, when set, wins.
DB_SSL=false
# Keep true. Only set false for a provider with a self-signed cert and no CA to pin.
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional: the provider's CA certificate (PEM; "\n" escapes are accepted).
DB_SSL_CA=
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=10000
# Optional safety net for runaway queries (0/empty = off).
DB_STATEMENT_TIMEOUT_MS=
# Local sqlite file (development only, when no Postgres settings are given).
SQLITE_PATH=draughts_db.sqlite

# --- Redis (optional) ---------------------------------------------------------
# Socket.IO adapter. Without it the in-memory adapter is used (single instance).
REDIS_URL=

# --- Access control -----------------------------------------------------------
# Staff roles: ADMIN, MODERATOR, ORGANIZER, CONTENT_EDITOR (players have none).
# Usernames promoted to ADMIN at boot (comma-separated). Promote-only. Other roles:
#   npm run admin:grant -- <username> [ROLE] [--revoke]   or the Admin page.
ADMIN_USERNAMES=

# --- Rate limiting ------------------------------------------------------------
# Default requests/minute per client IP (auth routes have stricter fixed limits).
RATE_LIMIT_PER_MINUTE=300

# --- Logging & error tracking ---------------------------------------------------
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=
# "json" forces JSON logs outside production (production is always JSON).
LOG_FORMAT=
# Optional Sentry-compatible DSN (Sentry, self-hosted Sentry, GlitchTip). Empty = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
# Optional version string reported by /health and error tracking (e.g. git SHA).
APP_VERSION=

# --- Engine workers -------------------------------------------------------------
# Worker threads for AI moves / game review / anti-cheat / puzzle generation.
# Default: CPU cores - 1 (min 1, max 4). 0 = run searches on the main thread (not
# recommended: a single AI move then freezes every other game).
AI_WORKERS=

# --- Puzzles ------------------------------------------------------------------
# Self-play seeding of the puzzle pool on first boot of an empty database.
PUZZLE_SEED_ON_BOOT=true

# --- Plans & payments: Stripe (optional — all or none) --------------------------
# Plans (Free / Plus / Premium) and what they unlock: src/billing/plans.ts.
# One Stripe Price per plan and interval (current catalog version). When prices
# change, add a new catalog version with NEW env names and keep these set so
# existing subscribers renew on their original version.
#
# Nothing else needs to change to go live: once these are set (plus the two keys
# above), the pricing page automatically shows the real Stripe-configured prices
# and checkout/webhooks start working — see docs/ACCESS-AND-BILLING.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=
# Stripe webhook endpoint to configure in the Stripe dashboard:
#   https://<your-api-host>/api/v1/subscriptions/webhook

# --- Free trial (no card, once per account) -------------------------------------
TRIALS_ENABLED=true
TRIAL_DAYS=7
# PLUS or PREMIUM
TRIAL_PLAN=PLUS

# --- Email: Resend (optional) -------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
